# DigitalOcean staging — placeholders only.
# Copy to .env.production on the droplet (never commit real secrets).
# Path: /opt/lrp/app/.env.production
#
# Staging/demo data ONLY. Do NOT load real credit reports, SSNs, identity
# documents, or production PII into this environment.

# --- Runtime ---
APP_ENV=staging
APP_HOSTNAME=app.example.com
PUBLIC_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
CADDY_ACME_EMAIL=ops@example.com
IMAGE_TAG=latest
SKIP_DB_MIGRATIONS=true

# --- Secrets (generate with: openssl rand -hex 32) ---
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# --- Database (internal Docker network only) ---
POSTGRES_USER=lrp_staging
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=verdin_credit
DATABASE_URL=postgresql+asyncpg://lrp_staging:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/verdin_credit
DATABASE_URL_SYNC=postgresql://lrp_staging:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/verdin_credit

# --- Redis / worker ---
REDIS_URL=redis://redis:6379/0
WORKER_QUEUE_NAME=verdin:jobs

# --- Object storage (MinIO — internal only; no public console) ---
MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_PASSWORD_MIN_12_CHARS
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_USER
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_PASSWORD_MIN_12_CHARS
MINIO_BUCKET=verdin-documents
MINIO_SECURE=false

# --- Feature flags (staging defaults) ---
# Client portal ON; unfinished AI / enterprise surfaces OFF.
ENABLE_CLIENT_PORTAL=true
ENABLE_CLIENT_ENROLLMENT=false
ENABLE_IMPORTS=true
ENABLE_AI=false
ENABLE_LLM=false
ENABLE_ENTERPRISE=false
ENABLE_ML_SCORING=false
ENABLE_LLM_ACCOUNT_RECOMMENDATIONS=false
ENABLE_EMAIL_DELIVERY=false
ENABLE_BILLING=false
DOCUMENT_OCR_ENABLED=true
ALLOW_DEMO_ORGS=true
ENABLE_SAMPLE_DATA=true
ENABLE_DEMO_LOGIN=false

# Frontend build-time flags (rebuild web after changes)
VITE_API_BASE_URL=
VITE_ENABLE_CLIENT_PORTAL=true
VITE_ENABLE_CLIENT_ENROLLMENT=false
VITE_ENABLE_IMPORTS=true
VITE_ENABLE_AI=false
VITE_ENABLE_LLM=false
VITE_ENABLE_ENTERPRISE=false
VITE_ENABLE_PORTAL_PUSH=false

# --- Optional email ---
# Prefer Microsoft Graph (OAuth2 client credentials) for Microsoft 365:
# ENABLE_EMAIL_DELIVERY=true
# EMAIL_PROVIDER=microsoft_graph
# EMAIL_FROM_ADDRESS=info@example.com
# EMAIL_GRAPH_TENANT_ID=
# EMAIL_GRAPH_CLIENT_ID=
# EMAIL_GRAPH_CLIENT_SECRET=
# EMAIL_GRAPH_SAVE_TO_SENT_ITEMS=true
#
# Legacy SMTP (basic auth / app passwords) still supported:
# EMAIL_PROVIDER=smtp
# EMAIL_FROM_ADDRESS=no-reply@example.com
# EMAIL_SMTP_HOST=smtp.office365.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USE_TLS=true
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=

# --- Optional Stripe test mode (never live keys on staging) ---
# ENABLE_BILLING=true
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# STRIPE_DEFAULT_PRICE_ID=price_REPLACE_ME
