NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Shared Ultimate Credit Repair / Verdin platform API (same Postgres)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# LRP-108 — demo auth fallback when platform login fails.
# Always disabled in production builds (NODE_ENV=production), regardless of these flags.
# Local/dev: default true when unset; set false/0 to force platform-only auth.
NEXT_PUBLIC_LRP_CRM_DEMO_AUTH=true
NEXT_PUBLIC_LRP_LENDER_DEMO_AUTH=true
